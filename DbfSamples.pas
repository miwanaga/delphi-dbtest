unit DbfSamples;

interface

uses DB, DBTables;

procedure PrepareSampleTable(Table: TTable);
procedure AddSampleRows(Table: TTable);

implementation

uses Windows, Classes, SysUtils, BDE;

type
  TNativeFields = array[0..13] of FLDDesc;

procedure DefineFields(var Fields: TNativeFields);

  procedure Define(Index: Integer; const Name: string; NativeType,
    Width, Decimals: Word);
  begin
    Fields[Index].iFldNum := Index + 1;
    StrPCopy(Fields[Index].szName, Name);
    Fields[Index].iFldType := NativeType;
    Fields[Index].iUnits1 := Width;
    Fields[Index].iUnits2 := Decimals;
  end;

begin
  FillChar(Fields, SizeOf(Fields), 0);
  Define(0, 'ID', fldDBCHAR, 10, 0);
  Define(1, 'NAME', fldDBCHAR, 50, 0);
  Define(2, 'ADDRESS', fldDBCHAR, 100, 0);
  Define(3, 'NUM_VAL', fldDBNUM, 12, 2);
  Define(4, 'FLOAT_VAL', fldDBFLOAT, 16, 4);
  Define(5, 'DOUBLE_VAL', fldDBDOUBLE, 8, 0);
  Define(6, 'BOOL_VAL', fldDBBOOL, 1, 0);
  Define(7, 'DATE_VAL', fldDBDATE, 8, 0);
  Define(8, 'STAMP_VAL', fldDBDATETIME, 8, 0);
  Define(9, 'LONG_VAL', fldDBLONG, 4, 0);
  Define(10, 'AUTO_VAL', fldDBAUTOINC, 4, 0);
  Define(11, 'MEMO_VAL', fldDBMEMO, 10, 0);
  Define(12, 'BIN_VAL', fldDBBINARY, 10, 0);
  Define(13, 'OLE_VAL', fldDBOLEBLOB, 10, 0);
end;

procedure CreateAllTypesTable(const Directory, Name: string);
var
  Database: TDatabase;
  Desc: CRTblDesc;
  Fields: TNativeFields;
  LevelOption: FLDDesc;
  Level: array[0..1] of Char;
begin
  Database := TDatabase.Create(nil);
  try
    Database.DatabaseName := 'DbfSampleSchema';
    Database.DriverName := 'STANDARD';
    Database.Params.Values['PATH'] := Directory;
    Database.Params.Values['DEFAULT DRIVER'] := 'DBASE';
    Database.Open;
    DefineFields(Fields);
    FillChar(Desc, SizeOf(Desc), 0);
    StrPCopy(Desc.szTblName, Name);
    StrCopy(Desc.szTblType, szDBASE);
    Desc.iFldCount := Length(Fields);
    Desc.pfldDesc := @Fields[0];
    FillChar(LevelOption, SizeOf(LevelOption), 0);
    StrCopy(LevelOption.szName, szCFGDRVLEVEL);
    LevelOption.iLen := 2;
    StrCopy(Level, '7');
    Desc.iOptParams := 1;
    Desc.pfldOptParams := @LevelOption;
    Desc.pOptData := @Level;
    { Physical descriptors preserve N, F and O as three distinct DBF types. }
    Check(DbiCreateTable(Database.Handle, False, Desc));
  finally
    Database.Free;
  end;
end;

procedure SetExampleValues(Table: TTable; Number: Integer);
begin
  Table.FieldByName('NUM_VAL').AsFloat := Number * 123.45;
  Table.FieldByName('FLOAT_VAL').AsFloat := Number * 1.2345;
  Table.FieldByName('DOUBLE_VAL').AsFloat := Number * 123456.789012;
  Table.FieldByName('BOOL_VAL').AsBoolean := Odd(Number);
  Table.FieldByName('DATE_VAL').AsDateTime := EncodeDate(2026, 10, 20 + Number mod 8);
  Table.FieldByName('STAMP_VAL').AsDateTime := EncodeDate(2026, 10, 27) +
    EncodeTime(9, Number mod 60, 30, 125);
  Table.FieldByName('LONG_VAL').AsInteger := Number * 100000;
  Table.FieldByName('MEMO_VAL').AsString := 'Memo sample ' + IntToStr(Number) +
    #13#10 + 'A second line stored in sample.dbt.';
  TBlobField(Table.FieldByName('BIN_VAL')).AsString := #0#1#2#127#255 +
    'Binary sample ' + IntToStr(Number);
  { AUTO_VAL is generated by dBASE. OLE_VAL stays NULL until a real OLE
    object is supplied; arbitrary bytes are not a valid OLE object. }
end;

procedure CheckNativeSchema(const FileName: string);
const
  ExpectedTypes: array[0..13] of Char =
    ('C', 'C', 'C', 'N', 'F', 'O', 'L', 'D', '@', 'I', '+', 'M', 'B', 'G');
var
  Stream: TFileStream;
  Header: array[0..67] of Byte;
  Field: array[0..47] of Byte;
  I: Integer;
  Fields: TNativeFields;
begin
  DefineFields(Fields);
  Stream := TFileStream.Create(FileName, fmOpenRead or fmShareDenyNone);
  try
    Stream.ReadBuffer(Header, SizeOf(Header));
    if (Header[0] and 7) <> 4 then
      raise EDatabaseError.Create('The all-types sample requires a dBASE Level 7 table.');
    for I := Low(ExpectedTypes) to High(ExpectedTypes) do
    begin
      Stream.ReadBuffer(Field, SizeOf(Field));
      if (StrPas(PAnsiChar(@Field[0])) <> StrPas(Fields[I].szName)) or
        (Char(Field[32]) <> ExpectedTypes[I]) then
        raise EDatabaseError.CreateFmt('Unexpected DBF definition for %s.',
          [StrPas(Fields[I].szName)]);
    end;
  finally
    Stream.Free;
  end;
end;

procedure UpgradeLegacyTable(const Directory: string);
var
  Source, Dest: TTable;
  TempName, BackupName: string;
  Number: Integer;
begin
  Source := TTable.Create(nil);
  Dest := TTable.Create(nil);
  try
    Source.DatabaseName := Directory;
    Source.TableName := 'sample.dbf';
    { Normal startup only inspects the schema with shared access. }
    Source.Open;
    if Source.FieldDefs.Count = 14 then
      Exit;
    Source.Close;
    { Only a legacy schema upgrade needs exclusive access for the rename. }
    Source.Exclusive := True;
    try
      Source.Open;
    except
      on E: EDBEngineError do
        raise EDatabaseError.CreateFmt(
          'Cannot upgrade sample.dbf. Close other applications or IDE datasets ' +
          'using this table, then retry. BDE: %s', [E.Message]);
    end;
    { Another process may have completed an upgrade since the shared check. }
    if Source.FieldDefs.Count = 14 then
      Exit;
    if (Source.FieldDefs.Count <> 3) or
      (Source.Fields[0].FieldName <> 'ID') or
      (Source.Fields[1].FieldName <> 'NAME') or
      (Source.Fields[2].FieldName <> 'ADDRESS') or
      (Source.Fields[0].DataType <> ftString) or
      (Source.Fields[1].DataType <> ftString) or
      (Source.Fields[2].DataType <> ftString) then
      raise EDatabaseError.Create('sample.dbf has an unrecognized schema; it was not changed.');
    TempName := 't' + IntToHex(GetTickCount, 8) + '.dbf';
    BackupName := 'sample_before_alltypes_' +
      FormatDateTime('yyyymmddhhnnsszzz', Now) + '.dbf';
    if FileExists(IncludeTrailingPathDelimiter(Directory) + TempName) or
      FileExists(IncludeTrailingPathDelimiter(Directory) + BackupName) then
      raise EDatabaseError.Create('An upgrade file already exists. Retry later.');
    CreateAllTypesTable(Directory, TempName);
    Dest.DatabaseName := Directory;
    Dest.TableName := TempName;
    Dest.Open;
    Number := 0;
    while not Source.Eof do
    begin
      Inc(Number);
      Dest.Append;
      try
        Dest.FieldByName('ID').Value := Source.FieldByName('ID').Value;
        Dest.FieldByName('NAME').Value := Source.FieldByName('NAME').Value;
        Dest.FieldByName('ADDRESS').Value := Source.FieldByName('ADDRESS').Value;
        SetExampleValues(Dest, Number);
        Dest.Post;
      except
        Dest.Cancel;
        raise;
      end;
      Source.Next;
    end;
    Dest.Close;
    Source.Close;
    CheckNativeSchema(IncludeTrailingPathDelimiter(Directory) + TempName);
    { Keep the old table as a backup. RenameTable also handles sidecar files. }
    Source.RenameTable(BackupName);
    try
      Dest.RenameTable('sample.dbf');
    except
      Source.RenameTable('sample.dbf');
      raise;
    end;
  finally
    Dest.Free;
    Source.Free;
  end;
end;

procedure PrepareSampleTable(Table: TTable);
begin
  Table.Close;
  if Table.Exists then
    UpgradeLegacyTable(Table.DatabaseName)
  else
    CreateAllTypesTable(Table.DatabaseName, Table.TableName);
  CheckNativeSchema(IncludeTrailingPathDelimiter(Table.DatabaseName) + Table.TableName);
end;

procedure AddSampleRows(Table: TTable);
const
  Names: array[1..3] of string = ('Taro Yamada', 'Hanako Suzuki', 'Ichiro Sato');
  Addresses: array[1..3] of string = ('Tokyo', 'Osaka', 'Nagoya');
var
  I: Integer;
begin
  if not Table.IsEmpty then
    Exit;
  for I := 1 to 3 do
  begin
    Table.Append;
    try
      Table.FieldByName('ID').AsString := Format('%.3d', [I]);
      Table.FieldByName('NAME').AsString := Names[I];
      Table.FieldByName('ADDRESS').AsString := Addresses[I];
      SetExampleValues(Table, I);
      Table.Post;
    except
      Table.Cancel;
      raise;
    end;
  end;
end;

end.
